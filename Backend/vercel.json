  {
    "version": 2,
    "builds": [
        {
            "src": "server.ts",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "dist/**"
                ]
            }
        }
    ],
  "routes": [
      {
          "src": "/(.*)",
          "dest": "server.ts"
      }
  ],
  "functions": {
      "server.ts": {
          "maxDuration": 60
      }
  }
}